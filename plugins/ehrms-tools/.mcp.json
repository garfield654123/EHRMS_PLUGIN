{
  "ehrms-database": {
    "command": "py",
    "args": ["${CLAUDE_PLUGIN_ROOT}/servers/MCP_1.0/server.py"],
    "env": {
      "MCP_MODE": "stdio",
      "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/servers/MCP_1.0",
      "MSSQL_SERVER": "${MSSQL_SERVER}",
      "MSSQL_DATABASE": "${MSSQL_DATABASE}",
      "MSSQL_USERNAME": "${MSSQL_USERNAME}",
      "MSSQL_PASSWORD": "${MSSQL_PASSWORD}"
    }
  },
  "EHRMS-jira-mcp": {
    "command": "py",
    "args": ["-m", "jira_mcp"],
    "env": {
      "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/servers/JIRA_MCP",
      "JIRA_BASE_URL": "${JIRA_BASE_URL}",
      "JIRA_EMAIL": "${JIRA_EMAIL}",
      "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
    }
  },
  "ehrms-codegraph": {
    "command": "py",
    "args": ["${CLAUDE_PLUGIN_ROOT}/servers/CODEGRAPH/server.py"],
    "env": {
      "MCP_MODE": "stdio",
      "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/servers/CODEGRAPH",
      "CODEGRAPH_DB": "${CLAUDE_PLUGIN_ROOT}/servers/CODEGRAPH/codegraph.sqlite",
      "MSSQL_SERVER": "${MSSQL_SERVER}",
      "MSSQL_DATABASE": "${MSSQL_DATABASE}",
      "MSSQL_USERNAME": "${MSSQL_USERNAME}",
      "MSSQL_PASSWORD": "${MSSQL_PASSWORD}"
    }
  }
}
