{
  "mcpServers": {
  "ehrms-database": {
    "command": "py",
    "args": ["-3", "-B", "scripts/run_mcp.py", "database"],
    "cwd": ".",
    "env_vars": ["MSSQL_SERVER", "MSSQL_DATABASE", "MSSQL_USERNAME", "MSSQL_PASSWORD", "EHRMS_ENV_FILE"]
  },
  "EHRMS-jira-mcp": {
    "command": "py",
    "args": ["-3", "-B", "scripts/run_mcp.py", "jira"],
    "cwd": ".",
    "env_vars": ["JIRA_BASE_URL", "JIRA_EMAIL", "JIRA_API_TOKEN", "EHRMS_ENV_FILE"]
  },
  "ehrms-memory": {
    "command": "py",
    "args": ["-3", "-B", "scripts/run_mcp.py", "memory"],
    "cwd": ".",
    "env_vars": ["MSSQL_SERVER", "MSSQL_DATABASE", "MSSQL_USERNAME", "MSSQL_PASSWORD", "JIRA_EMAIL", "MEMORY_USER", "EHRMS_ENV_FILE"]
  }
  }
}
